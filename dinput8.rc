// dinput8.dll's version resource: who made it and what it is, as Windows shows it under Properties > Details (Attila's
// heapfix/dinput8.rc). The mod's own name and version (version.h), not Microsoft's DirectInput: it only forwards
// DirectInput8Create. Without it Microsoft's cloud ML flagged 2.0 as Trojan:Win32/Wacatac.B!ml (VirusTotal, 2026-11-02).
#include <winver.h>
#include "version.h"


VS_VERSION_INFO VERSIONINFO
FILEVERSION     MOD_VERSION_RC
PRODUCTVERSION  MOD_VERSION_RC
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "JGdaCaesar"
            VALUE "FileDescription",  "Rome 2 Engine Performance Fix (Total War: ROME II mod; forwards DirectInput8Create to Windows)"
            VALUE "FileVersion",      MOD_VERSION_STR
            VALUE "InternalName",     "Rome2CPUPerfFix"
            VALUE "LegalCopyright",   "JGdaCaesar. Source: github.com/JSa25/Rome2CPUPerfFix"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "Rome 2 Engine Performance Fix"
            VALUE "ProductVersion",   MOD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
